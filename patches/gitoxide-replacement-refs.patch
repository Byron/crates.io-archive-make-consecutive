diff --git a/gix/tests/fixtures/make_replacement_refs.sh b/gix/tests/fixtures/make_replacement_refs.sh
new file mode 100644
index 0000000000..9c680c953d
--- /dev/null
+++ b/gix/tests/fixtures/make_replacement_refs.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -eu -o pipefail
+
+# Two disconnected segments, plus a raw commit-graph created before grafting.
+# Tests install the replacement after opening a repository to exercise reopening.
+git init -q repo
+(
+  cd repo
+  tree=$(git mktree </dev/null)
+  a=$(git commit-tree "$tree" -m A)
+  b=$(git commit-tree "$tree" -p "$a" -m B)
+  s=$(git commit-tree "$tree" -m S)
+  c=$(git commit-tree "$tree" -p "$s" -m C)
+  git update-ref refs/heads/archive "$b"
+  git update-ref refs/heads/squash "$s"
+  git update-ref refs/heads/restored "$c"
+  git symbolic-ref HEAD refs/heads/restored
+  git commit-graph write --reachable
+)
+git clone -q --bare repo bare
+(
+  cd bare
+  git commit-graph write --reachable
+)
