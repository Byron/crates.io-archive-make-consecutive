 gix/src/open/repository.rs                    |   5 +-
 gix/src/repository/graph.rs                   |  13 +-
 gix/src/revision/walk.rs                      |  17 ++-
 .../make_replacement_refs.tar                 | Bin 0 -> 125952 bytes
 gix/tests/fixtures/make_replacement_refs.sh   |  24 ++++
 gix/tests/gix/revision/mod.rs                 |   1 +
 gix/tests/gix/revision/replacements.rs        | 112 ++++++++++++++++++
 9 files changed, 167 insertions(+), 21 deletions(-)
